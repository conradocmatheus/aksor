<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage: <%= event.eventName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .container { max-width: 960px; }
        .card-header h2 { margin-bottom: 0; }
        #qrCodeImage {
            width: 650px;
            height: 650px;
            max-width: 100%;
            margin: auto;
            display: block;
        }
        .modal-dialog-centered { min-height: calc(100% - 1rem); }
        .students-scroll {
            max-height: 400px;
            overflow-y: auto;
        }
        
    </style>
</head>
<body>
    <div class="container my-5">
        <div class="p-5 mb-4 bg-light rounded-3">
            <h1 class="display-5 fw-bold">Gerenciar: <%= event.eventName %></h1>
            <p class="col-md-8 fs-5">Marque esta página como favorita para acessá-la depois.</p>
            <input type="text" readonly class="form-control" value="<%= new URL(req.originalUrl, `${req.protocol}://${req.get('host')}`).href %>">
        </div>

        <div class="row g-5">
            <div class="col-md-5 col-lg-4 order-md-last">
                <div class="card shadow-sm mb-4">
                    <div class="card-header"><h2 class="h5">Ação Rápida</h2></div>
                    <div class="card-body">
                        <% if (sessionData) { %>
                            <button type="button" class="btn btn-primary btn-lg w-100" data-bs-toggle="modal" data-bs-target="#qrModal">
                                Reabrir QR Code
                            </button>
                        <% } else { %>
                            <form action="/event/<%= event.id %>/start-session" method="POST">
                                <button type="submit" class="btn btn-primary btn-lg w-100">Iniciar Sessão de Chamada</button>
                            </form>
                        <% } %>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header">
                        <h2 class="h5">Configurações</h2>
                    </div>
                    <div class="card-body">
                        <form action="/event/<%= event.id %>/settings" method="POST">
                            <div class="mb-3">
                                <label for="expirationInSeconds" class="form-label">Expiração do QR Code (s)</label>
                                <input type="number" class="form-control" id="expirationInSeconds" name="expirationInSeconds" value="<%= event.expirationInSeconds %>" required>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="allowMultipleIPs" name="allowMultipleIPs" <%= event.allowMultipleIPs ? 'checked' : '' %>>
                                <label class="form-check-label" for="allowMultipleIPs">
                                    Permitir múltiplos registros do mesmo IP
                                </label>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100">Atualizar Configurações</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-7 col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h2 class="h5">Alunos (<%= students.length %>)</h2>
                    </div>
                    <div class="card-body">
                        <form action="/event/<%= event.id %>/upload-students" method="POST" enctype="multipart/form-data">
                            <label for="studentsCsv" class="form-label">Enviar CSV (colunas: studentId, fullName)</label>
                            <div class="input-group">
                                <input type="file" class="form-control" id="studentsCsv" name="studentsCsv" accept=".csv" required>
                                <button type="submit" class="btn btn-outline-secondary">Enviar e Substituir</button>
                            </div>
                        </form>
                    </div>
                    <% if (students.length > 0) { %>
                    <div class="table-responsive students-scroll">
                        <table class="table table-striped table-hover mb-0">
                            <thead><tr><th>ID do Aluno</th><th>Nome Completo</th></tr></thead>
                            <tbody>
                            <% students.forEach(student => { %>
                                <tr><td><%= student.studentId %></td><td><%= student.fullName %></td></tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header"><h2 class="h5">Relatórios</h2></div>
                    <% if (sessions.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead><tr><th>Sessão Iniciada em</th><th>Ação</th></tr></thead>
                            <tbody>
                            <% sessions.forEach(session => { %>
                                <tr>
                                    <td><%= new Date(session.generatedAt._seconds * 1000).toLocaleString() %></td>
                                    <td><a href="/event/<%= event.id %>/session/<%= session.id %>">Ver Detalhes</a></td>
                                </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                        <div class="card-body"><p class="text-muted">Nenhuma sessão de chamada foi iniciada ainda.</p></div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <% if (sessionData) { %>
    <div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h5 class="modal-title" id="qrModalLabel">Aponte a Câmera Para o QR Code</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <img id="qrCodeImage" src="<%= sessionData.qrCodeDataUrl %>" alt="QR Code" class="img-fluid mb-3">
                    <p class="display-4 fw-bold text-danger my-3">
                        Tempo Restante: <span id="countdown"></span>
                    </p>
                    <p class="text-muted">Ou use o link:</p>
                    <input type="text" class="form-control text-center" readonly value="<%= sessionData.checkinUrl %>">
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <% if (sessionData) { %>
    <script>
        const qrModalElement = document.getElementById('qrModal');
        const countdownElement = document.getElementById('countdown');
        const expiresAt = new Date(<%= sessionData.sessionExpiresAt %>);
        let countdownInterval;

        function startCountdown() {
            if (countdownInterval) clearInterval(countdownInterval);

            countdownInterval = setInterval(() => {
                const now = new Date();
                const diff = Math.round((expiresAt - now) / 1000);
                if (diff <= 0) {
                    clearInterval(countdownInterval);
                    countdownElement.textContent = "EXPIRADO";
                    document.getElementById('qrCodeImage').style.opacity = '0.2';
                } else {
                    const minutes = Math.floor(diff / 60);
                    const seconds = diff % 60;
                    countdownElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                }
            }, 1000);
        }
        
        qrModalElement.addEventListener('shown.bs.modal', startCountdown);

        qrModalElement.addEventListener('hidden.bs.modal', () => {
            clearInterval(countdownInterval);
        });
        
        const myModal = new bootstrap.Modal(qrModalElement);
        myModal.show();
    </script>
    <% } %>
</body>
</html>