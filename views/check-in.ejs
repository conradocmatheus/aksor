<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmar Presença</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            background-color: #f8f9fa;
        }
        .checkin-card {
            width: 100%;
            max-width: 400px;
        }
    </style>
</head>
<body>
    <div class="card shadow-lg checkin-card">
        <div class="card-body p-5">
            <h1 class="card-title text-center mb-4">Confirmar Presença</h1>
            <% if (token) { %>
            <form action="/register-attendance" method="POST" id="attendanceForm">
                <input type="hidden" name="token" value="<%= token %>">
                <div class="mb-3">
                    <label for="studentId" class="form-label">Seu ID de Aluno (RA)</label>
                    <input type="text" class="form-control form-control-lg text-center" id="studentId" name="studentId" required autofocus>
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Confirmar Presença</button>
            </form>
            <% } else { %>
                <div class="alert alert-danger">Sessão inválida.</div>
            <% } %>
        </div>
    </div>

    <% if (swal) { %>
    <script>
        Swal.fire({
            icon: '<%= swal.icon %>',
            title: '<%= swal.title %>',
            text: '<%= swal.text %>',
            confirmButtonColor: '#3085d6'
        });

        <% if (swal.disableForm) { %>
            document.getElementById('studentId').disabled = true;
            document.querySelector('button[type="submit"]').disabled = true;
        <% } %>
    </script>
    <% } %>
</body>
</html>