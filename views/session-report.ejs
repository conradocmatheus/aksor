<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatório da Sessão</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container my-5">
        <div class="text-center mb-4">
            <h1 class="display-6">Relatório de Presença</h1>
            <p class="lead text-muted"><%= event.eventName %></p>
            <p>Sessão de: <%= new Date(session.generatedAt._seconds * 1000).toLocaleString() %></p>
        </div>

        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h2 class="h5 mb-0">Presentes (<%= presentStudents.length %>)</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead><tr><th>RA</th><th>Nome</th></tr></thead>
                            <tbody>
                                <% presentStudents.forEach(student => { %>
                                    <tr><td><%= student.studentId %></td><td><%= student.fullName %></td></tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-danger text-white">
                        <h2 class="h5 mb-0">Ausentes (<%= absentStudents.length %>)</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead><tr><th>RA</th><th>Nome</th></tr></thead>
                            <tbody>
                                <% absentStudents.forEach(student => { %>
                                    <tr><td><%= student.studentId %></td><td><%= student.fullName %></td></tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>