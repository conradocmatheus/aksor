<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Evento de Chamada</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            background-color: #f8f9fa;
        }
        .create-card {
            width: 100%;
            max-width: 500px;
        }
    </style>
</head>
<body>
    <div class="card shadow-lg create-card">
        <div class="card-body p-5">
            <h1 class="card-title text-center mb-4">Novo Evento de Chamada</h1>
            <form action="/create-event" method="POST">
                <div class="mb-3">
                    <label for="eventName" class="form-label">Nome do Evento (Ex: Cálculo I - 2025)</label>
                    <input type="text" class="form-control form-control-lg" id="eventName" name="eventName" required>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Criar Evento e Gerenciar</button>
            </form>
        </div>
    </div>
</body>
</html>